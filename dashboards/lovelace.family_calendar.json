                  "type": "custom:html-template-card",
                  "ignore_line_breaks": true,
                  "content": "<style>\n  .mr{display:flex;flex-direction:row;gap:5px;width:100%;box-sizing:border-box;padding:4px 8px 6px 8px;background:transparent}\n  .mc{flex:1;min-width:0;padding:0 2px}\n  .mi{font-size:16px;line-height:1.3;color:#cccccc;background:rgba(255,255,255,0.06);border-radius:4px;padding:4px 6px;margin-bottom:3px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;cursor:pointer}\n  .mi:hover{background:rgba(255,255,255,0.15)}\n  .mt{color:#ff6666}\n  .me{color:#555;font-size:14px;text-align:center}\n  ha-card,#content{background:transparent !important;box-shadow:none !important;border:none !important;padding:0 !important;margin:0 !important}\n</style>\n{% set MEAL_PLANNER_URL = 'http://your-meal-planner-host:8002' %}\n{% set meals = state_attr('sensor.meal_plan', 'meals') or [] %}\n<div class=\"mr\">\n{% set dow = now().weekday() %}\n{% set days_since_sunday = (dow + 1) % 7 %}\n{% for i in range(7) %}\n  {% set local_d = (now() + timedelta(days=i - days_since_sunday)).strftime('%Y-%m-%d') %}\n  {% set search_d = local_d %}\n  {% set day_meals = meals | selectattr('from_date', 'search', search_d) | list %}\n  <div class=\"mc\">\n  {% if day_meals | length == 0 %}\n    <div class=\"me\">—</div>\n  {% else %}\n    {% for m in day_meals %}\n      {% if m.recipe %}\n        {% set name = m.recipe.name %}\n        {% set url = MEAL_PLANNER_URL + '/recipe/' + (m.recipe.id | string) %}\n      {% else %}\n        {% set name = m.title %}\n        {% set url = MEAL_PLANNER_URL %}\n      {% endif %}\n      <div class=\"mi{% if local_d == now().strftime('%Y-%m-%d') %} mt{% endif %}\" onclick=\"window.open('{{ url }}','_blank')\">{{ name }}</div>\n    {% endfor %}\n  {% endif %}\n  </div>\n{% endfor %}\n</div>\n"
